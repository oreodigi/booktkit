BOOKTKIT_BASE_URL=https://www.booktkit.com
# Keep credentials out of git. Authenticated test accounts will be added through runtime secrets.
BOOKTKIT_TEST_CUSTOMER_EMAIL=
BOOKTKIT_TEST_CUSTOMER_PASSWORD=
BOOKTKIT_TEST_ORGANIZER_EMAIL=
BOOKTKIT_TEST_ORGANIZER_PASSWORD=
BOOKTKIT_TEST_ORGANIZER_USERNAME=
BOOKTKIT_ALLOW_MUTATIONS=false
BOOKTKIT_RAZORPAY_TEST_ENABLED=false

# Remote MCP control plane (never commit real values)
BOOKTKIT_GITHUB_TOKEN=
BOOKTKIT_MCP_TOKEN=
